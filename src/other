use serde::{Deserialize, Serialize, ser::SerializeStruct};

struct Message<const N: usize> {
    pub version: u16,
    pub count: u16,
    pub previous: u16,
    pub public_key: PublicKey,
    pub nonce: [u8; NONCE_LENGTH],
    pub header_nonce: Option<[u8; NONCE_LENGTH]>,
    pub payload: [u8;N]
}
impl<const N: usize> Message<N> {
    pub fn new() {
        
    }

    pub fn hash(&self) -> [u8; 32] {
        Sha256::digest(self.to_bytes()).into()
    }
}

impl<const N: usize> Serialize for Message<N> {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer {
            let mut state = serializer.serialize_struct("Message", 7)?;
        state.serialize_field("version", &self.version)?;
        state.serialize_field("count", &self.count)?;
        state.serialize_field("previous", &self.previous)?;
        state.serialize_field("public_key", self.public_key.as_bytes())?;
        state.serialize_field("nonce", &self.nonce)?;
        state.serialize_field("header_nonce", &self.header_nonce)?;
        state.serialize_field("payload", self.payload.as_ref())?;
        state.end()
    }
}

use aes_gcm::{
    Aes256Gcm, Nonce,
    aead::{Aead, KeyInit},
};

const MESSAGE_KEY_INFO: &[u8] = b"/freesignal/message_keys/v0.1";
const HEADER_SIZE: usize = 36;
const NONCE_SIZE: usize = 12;

#[derive(Debug)]
pub enum EncryptionError {
    DoubleRatchet(DoubleRatchetError),
    PacketTooShort,
    CipherError,
}

impl std::fmt::Display for EncryptionError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::DoubleRatchet(e) => write!(f, "Double Ratchet error: {}", e),
            Self::PacketTooShort => write!(
                f,
                "Encrypted packet is too short to contain header and nonce"
            ),
            Self::CipherError => write!(f, "Symmetric encryption/decryption failed"),
        }
    }
}

impl std::error::Error for EncryptionError {}

impl From<DoubleRatchetError> for EncryptionError {
    fn from(err: DoubleRatchetError) -> Self {
        EncryptionError::DoubleRatchet(err)
    }
}

fn derive_msg_cipher_keys(msg_key: &MessageKey) -> ([u8; 32], [u8; 12]) {
    let hkdf = Hkdf::<Sha256>::new(Some(&[0u8; 32]), &msg_key.0);
    let mut okm = [0u8; 44]; // 32 B per la chiave + 12 B per il Nonce
    hkdf.expand(MESSAGE_KEY_INFO, &mut okm)
        .expect("HKDF expansion length is valid");

    let mut enc_key = [0u8; 32];
    let mut nonce = [0u8; 12];

    enc_key.copy_from_slice(&okm[..32]);
    nonce.copy_from_slice(&okm[32..44]);

    (enc_key, nonce)
}

pub fn encrypt<K: SessionKeyStore<SessionData, Chain> + Clone>(
    session: &mut Session<K>,
    plaintext: &[u8],
) -> Result<Vec<u8>, EncryptionError> {
    let (msg_key, header, header_key) = session.get_sending_key()?;
    let (enc_key, nonce_bytes) = derive_msg_cipher_keys(&msg_key);

    let cipher = Aes256Gcm::new_from_slice(&enc_key).map_err(|_| EncryptionError::CipherError)?;
    let nonce = Nonce::from_slice(&nonce_bytes);

    let ciphertext = cipher
        .encrypt(nonce, plaintext)
        .map_err(|_| EncryptionError::CipherError)?;

    // 4. Assembla il pacchetto binario da inviare sulla rete
    let header_bytes = header.to_bytes();
    let mut packet = Vec::with_capacity(HEADER_SIZE + NONCE_SIZE + ciphertext.len());
    packet.extend_from_slice(&header_bytes);
    packet.extend_from_slice(&nonce_bytes);
    packet.extend_from_slice(&ciphertext);

    Ok(packet)
}

/// Decifra un pacchetto cifrato avanzando o aggiornando la receiving chain della Sessione.
pub fn decrypt<K>(session: &mut Session<K>, packet: &[u8]) -> Result<Vec<u8>, EncryptionError>
where
    K: SessionKeyStore<SessionData, Chain> + Clone,
{
    // 1. Controllo dimensione minima del pacchetto
    if packet.len() < HEADER_SIZE + NONCE_SIZE {
        return Err(EncryptionError::PacketTooShort);
    }

    // 2. Parsing dell'Header e estrazione di Nonce e Ciphertext
    let header_bytes: &[u8; 36] = packet[..HEADER_SIZE]
        .try_into()
        .map_err(|_| EncryptionError::PacketTooShort)?;

    let nonce_bytes = &packet[HEADER_SIZE..HEADER_SIZE + NONCE_SIZE];
    let ciphertext = &packet[HEADER_SIZE + NONCE_SIZE..];

    let header = Header::from_bytes(header_bytes);

    // 3. Calcola o recupera la MessageKey dal Double Ratchet
    let msg_key = session.get_receiving_key(&header)?;

    // 4. Deriva la chiave AES-256 dal MessageKey
    let (enc_key, expected_nonce) = derive_msg_cipher_keys(&msg_key);

    // Option: verifica la corrispondenza del nonce
    if nonce_bytes != expected_nonce {
        return Err(EncryptionError::CipherError);
    }

    // 5. Decifratura con AES-256-GCM
    let cipher = Aes256Gcm::new_from_slice(&enc_key).map_err(|_| EncryptionError::CipherError)?;
    let nonce = Nonce::from_slice(nonce_bytes);

    let plaintext = cipher
        .decrypt(nonce, ciphertext)
        .map_err(|_| EncryptionError::CipherError)?;

    Ok(plaintext)
}