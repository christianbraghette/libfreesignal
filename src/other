use serde::{Deserialize, Serialize, ser::SerializeStruct};

struct Message<const N: usize> {
    pub version: u16,
    pub count: u16,
    pub previous: u16,
    pub public_key: PublicKey,
    pub nonce: [u8; NONCE_LENGTH],
    pub header_nonce: Option<[u8; NONCE_LENGTH]>,
    pub payload: [u8;N]
}
impl<const N: usize> Message<N> {
    pub fn new() {
        
    }

    pub fn hash(&self) -> [u8; 32] {
        Sha256::digest(self.to_bytes()).into()
    }
}

impl<const N: usize> Serialize for Message<N> {
    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
    where
        S: serde::Serializer {
            let mut state = serializer.serialize_struct("Message", 7)?;
        state.serialize_field("version", &self.version)?;
        state.serialize_field("count", &self.count)?;
        state.serialize_field("previous", &self.previous)?;
        state.serialize_field("public_key", self.public_key.as_bytes())?;
        state.serialize_field("nonce", &self.nonce)?;
        state.serialize_field("header_nonce", &self.header_nonce)?;
        state.serialize_field("payload", self.payload.as_ref())?;
        state.end()
    }
}